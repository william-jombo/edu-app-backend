# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# For PHP Backend API
# Copy this file to .env for local development
# For Fly.io production, use: flyctl secrets set KEY=VALUE

# ============================================
# ENVIRONMENT
# ============================================

# Application environment: development, staging, production
ENVIRONMENT=development

# ============================================
# DATABASE CONFIGURATION (SUPABASE)
# ============================================

# Supabase PostgreSQL Connection
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.axcjumdnwtgngxkanfzz
DB_PASSWORD=WJomBo.W/@Tw2111

# Connection pooling (Session pooler recommended for Supabase)
DB_POOL_MODE=session

# SSL Mode (require for Supabase)
DB_SSL_MODE=require

# ============================================
# APPLICATION SETTINGS
# ============================================

# Application Name
APP_NAME=Edu-App

# Backend URL (your Fly.io URL in production)
APP_URL=http://localhost:8080

# Frontend URL (your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Timezone
TIMEZONE=Africa/Blantyre

# ============================================
# CORS CONFIGURATION
# ============================================

# Allowed origins (comma-separated, no spaces)
# For local: http://localhost:5173
# For production: https://your-app.vercel.app
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=https://edu-app-rose.vercel.app
# Allow credentials (cookies, sessions)
ALLOW_CREDENTIALS=true

# ============================================
# SESSION CONFIGURATION
# ============================================

# Session lifetime in seconds (7200 = 2 hours)
SESSION_LIFETIME=7200

# Session name
SESSION_NAME=EDU_APP_SESSION

# Secure session cookies (true for HTTPS, false for local HTTP)
SESSION_SECURE=false

# HttpOnly cookies (recommended)
SESSION_HTTP_ONLY=true

# SameSite attribute (Strict, Lax, or None)
SESSION_SAME_SITE=Lax

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================

# Maximum upload size in bytes (10485760 = 10MB)
MAX_UPLOAD_SIZE=10485760

# Upload directory (relative to backend root)
UPLOAD_DIR=uploads

# Allowed file extensions (comma-separated)
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif,mp4,avi,mov

# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=application/pdf,application/msword,image/jpeg,image/png,video/mp4

# ============================================
# SECURITY SETTINGS
# ============================================

# Enable HTTPS redirect in production
FORCE_HTTPS=false

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# Password hashing cost (10-12 recommended)
PASSWORD_HASH_COST=10

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================

# SMTP Settings for sending emails
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@edu-app.com
MAIL_FROM_NAME=Edu-App

# ============================================
# LOGGING & DEBUGGING
# ============================================

# Log level: debug, info, warning, error
LOG_LEVEL=debug

# Enable error display (false in production)
DISPLAY_ERRORS=true

# Log file path
LOG_FILE=logs/app.log

# ============================================
# API SETTINGS
# ============================================

# API version
API_VERSION=v1

# API rate limiting
API_RATE_LIMIT=100

# API timeout (seconds)
API_TIMEOUT=30

# ============================================
# PAYMENT GATEWAY (Optional)
# ============================================

# If you plan to integrate payment processing
PAYMENT_GATEWAY=stripe
PAYMENT_PUBLIC_KEY=your-public-key
PAYMENT_SECRET_KEY=your-secret-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# CLOUD STORAGE (Optional)
# ============================================

# If you want to use cloud storage instead of local
STORAGE_DRIVER=local  # Options: local, s3, spaces
STORAGE_BUCKET=edu-app-uploads
STORAGE_REGION=us-east-1
STORAGE_KEY=your-storage-key
STORAGE_SECRET=your-storage-secret

# ============================================
# CACHE CONFIGURATION (Optional)
# ============================================

CACHE_DRIVER=file  # Options: file, redis, memcached
CACHE_TTL=3600

# Redis (if using)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================
# INSTRUCTIONS FOR DIFFERENT ENVIRONMENTS
# ============================================

# ============================================
# LOCAL DEVELOPMENT
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Update database credentials if different
# 3. Set ENVIRONMENT=development
# 4. Set DISPLAY_ERRORS=true
# 5. Set SESSION_SECURE=false (for HTTP)
# 6. Set ALLOWED_ORIGINS=http://localhost:5173
# 7. Start server: php -S localhost:8080 -t backend

# ============================================
# PRODUCTION (FLY.IO)
# ============================================
# Don't create .env file! Use Fly.io secrets:
#
# flyctl secrets set ENVIRONMENT=production
# flyctl secrets set DB_HOST=aws-1-eu-west-1.pooler.supabase.com
# flyctl secrets set DB_PORT=5432
# flyctl secrets set DB_NAME=postgres
# flyctl secrets set DB_USERNAME=postgres.axcjumdnwtgngxkanfzz
# flyctl secrets set DB_PASSWORD="WJomBo.W/@Tw2111"
# flyctl secrets set APP_URL=https://your-backend.fly.dev
# flyctl secrets set FRONTEND_URL=https://your-app.vercel.app
# flyctl secrets set ALLOWED_ORIGINS=https://your-app.vercel.app
# flyctl secrets set SESSION_SECURE=true
# flyctl secrets set FORCE_HTTPS=true
# flyctl secrets set DISPLAY_ERRORS=false
# flyctl secrets set LOG_LEVEL=error

# View all secrets:
# flyctl secrets list

# Remove a secret:
# flyctl secrets unset SECRET_NAME

# ============================================
# READING ENV VARS IN PHP
# ============================================
#
# Use getenv() function:
# $dbHost = getenv('DB_HOST');
# $environment = getenv('ENVIRONMENT') ?: 'development';
#
# Or use $_ENV superglobal:
# $dbHost = $_ENV['DB_HOST'] ?? 'localhost';
#
# Example in database.php:
# if (getenv('ENVIRONMENT') === 'production') {
#     $this->host = getenv('DB_HOST');
#     $this->password = getenv('DB_PASSWORD');
# } else {
#     $this->host = 'localhost';
#     $this->password = 'your-local-password';
# }

# ============================================
# SECURITY BEST PRACTICES
# ============================================
#
# ⚠️  CRITICAL:
# - Never commit .env file to Git
# - Add .env to .gitignore
# - Use strong passwords in production
# - Rotate credentials regularly
# - Use different credentials for dev/prod
# - Enable SSL/TLS for database connections
# - Use HTTPS in production (automatic on Fly.io)
# - Set SESSION_SECURE=true in production
# - Set DISPLAY_ERRORS=false in production
# - Restrict CORS origins to your domains only
#
# ✅  GOOD PRACTICES:
# - Use environment variables for all config
# - Never hardcode credentials in code
# - Use password hashing (bcrypt/argon2)
# - Implement rate limiting
# - Log security events
# - Regular security audits
# - Keep dependencies updated
# - Use prepared statements for SQL
# - Validate and sanitize all inputs
# - Implement CSRF protection

# ============================================
# TROUBLESHOOTING
# ============================================
#
# Issue: Environment variables not loading
# Solution: Check file permissions, use getenv() instead of $_ENV
#
# Issue: Database connection fails
# Solution: Verify credentials, check network/firewall, enable SSL
#
# Issue: CORS errors
# Solution: Add frontend URL to ALLOWED_ORIGINS, check headers
#
# Issue: Session not persisting
# Solution: Check SESSION_SECURE setting matches protocol (HTTP/HTTPS)
#
# Issue: File uploads failing
# Solution: Check upload directory permissions, max size limits
